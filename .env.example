# Database connection string (SQLite file path for Prisma)
DATABASE_URL="file:./dev.db"

# Server HTTP listening port (default: 3000)
PORT=3000

# Application execution environment (development | test | production)
NODE_ENV=development

# Auto-Simulation Engine: Duration per phase in milliseconds (default: 60000 = 1 min)
SIMULATION_PHASE_DURATION_MS=60000

# Auto-Simulation Engine: Toggle automatic time-based phase advancement (default: true)
SIMULATION_AUTO_ADVANCE=true

# CORS Allowed Origins: comma-separated list of allowed origins or '*' to allow all (default: *)
CORS_ORIGINS="*"

# Rate Limiting: Time window in milliseconds (default: 60000 = 1 minute)
RATE_LIMIT_WINDOW_MS=60000

# Rate Limiting: Maximum requests per window across /api endpoints (default: 100)
RATE_LIMIT_MAX=100

# Rate Limiting: Maximum evidence photo upload requests per window (default: 20)
RATE_LIMIT_EVIDENCE_MAX=20

# JWT Authentication Secret Key (required, minimum 32 characters)
# Generate a secure secret using:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="your-super-secret-jwt-key-min-32-chars-long"

# JWT Token Expiration duration (default: 1d)
JWT_EXPIRES_IN="1d"

# --- Gemini AI Vision (Phase 22) ---
# Google AI Studio API key (optional; if omitted, AI_MODE=auto falls back to simulated provider)
GEMINI_API_KEY=your_gemini_api_key_here

# Model name for vision analysis (verify current free-tier model in Google AI Studio)
GEMINI_MODEL="gemini-3.1-flash-lite"

# AI analysis mode: auto (uses Gemini if key configured, otherwise simulated) | gemini | simulated
AI_MODE=auto

# Fallback to simulated provider when Gemini errors (quota 429, timeout, network failure)
AI_FALLBACK_TO_SIMULATED=true

# Minimum confidence threshold (0.0 to 1.0) for license plate and wash phase detection
AI_MIN_CONFIDENCE=0.6

# Timeout for Gemini API requests in milliseconds (default: 20000 = 20s)
GEMINI_TIMEOUT_MS=20000

# Rate Limiting: Maximum AI camera analysis requests per window across /api/orders/:id/analyze (default: 10)
RATE_LIMIT_AI_MAX=10

# Realistic ETA: Optional phase duration overrides in JSON format (minutes)
# PHASE_ETA_MINUTES='{"PENDIENTE":10,"REMOJO":5,"LAVADO":15,"SECADO":10,"LISTO":0}'

# Rate Limiting: Maximum plate status lookups per minute (default: 30)
# PLATE_LOOKUP_RATE_LIMIT_PER_MINUTE=30

