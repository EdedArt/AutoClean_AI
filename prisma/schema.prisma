generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Vehicle {
  id            Int            @id @default(autoincrement())
  placa         String         @unique
  marca         String
  modelo        String
  color         String         @default("Sin especificar")
  ownerName     String         @default("Sin especificar")
  ownerId       Int?
  owner         User?          @relation("UserVehicles", fields: [ownerId], references: [id])
  nivelSuciedad String?
  createdAt     DateTime       @default(now())
  serviceOrders ServiceOrder[]
}

model Bay {
  id            Int            @id @default(autoincrement())
  numero        Int            @unique
  ocupada       Boolean        @default(false)
  serviceOrders ServiceOrder[]
}

model Package {
  id            Int            @id @default(autoincrement())
  nombre        String
  descripcion   String
  precio        Float?
  serviceOrders ServiceOrder[]
}

// ServicePhase: PENDIENTE | REMOJO | LAVADO | SECADO | LISTO
model ServiceOrder {
  id                  Int          @id @default(autoincrement())
  vehicleId           Int
  vehicle             Vehicle      @relation(fields: [vehicleId], references: [id])
  packageId           Int?
  package             Package?     @relation(fields: [packageId], references: [id])
  bayId               Int?
  bay                 Bay?         @relation(fields: [bayId], references: [id])
  faseActual          String       @default("PENDIENTE")
  porcentajeProgreso  Int          @default(10)
  listoParaLavar      Boolean      @default(false)
  readyAt             DateTime?
  horaEstimadaEntrega DateTime?
  deliveredAt         DateTime?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  evidences           Evidence[]
  phaseEvents         PhaseEvent[]
  aiAnalyses          AiAnalysis[]
}

model PhaseEvent {
  id        Int          @id @default(autoincrement())
  orderId   Int
  order     ServiceOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fase      String
  progreso  Int
  source    String       // "MANUAL" | "SIMULATION" | "DEMO" | "AI"
  createdAt DateTime     @default(now())

  @@index([orderId])
}

model AiAnalysis {
  id            Int          @id @default(autoincrement())
  orderId       Int
  order         ServiceOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider      String       // "gemini" | "simulated"
  model         String
  plateDetected String?
  plateMatched  Boolean
  phaseDetected String?
  confidence    Float?
  outcome       String       // "APPLIED" | "UNCHANGED" | "REGRESSION_IGNORED" | "WRONG_VEHICLE" | "PLATE_UNREADABLE" | "LOW_CONFIDENCE" | "ERROR"
  fallbackUsed  Boolean
  latencyMs     Int
  createdAt     DateTime     @default(now())

  @@index([orderId])
}

model Evidence {
  id             Int          @id @default(autoincrement())
  url            String
  etapa          String
  serviceOrderId Int
  serviceOrder   ServiceOrder @relation(fields: [serviceOrderId], references: [id])
  createdAt      DateTime     @default(now())
}

model User {
  id             Int             @id @default(autoincrement())
  email          String          @unique
  passwordHash   String
  nombre         String
  rol            String          // "OPERARIO" | "CLIENTE"
  createdAt      DateTime        @default(now())
  vehicles       Vehicle[]       @relation("UserVehicles")
  searchedPlates SearchedPlate[]
}

model SearchedPlate {
  id             Int      @id @default(autoincrement())
  userId         Int
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  placa          String
  lastSearchedAt DateTime @default(now())

  @@unique([userId, placa])
  @@index([userId, lastSearchedAt])
}
